# Database connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/ebookhub?schema=public"

# App & Server
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173
API_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# Authentication & Sessions
JWT_SECRET=your_jwt_secret_change_in_production
SESSION_SECRET=your_session_secret

# Storage Configuration (LOCAL or S3)
STORAGE_PROVIDER=LOCAL
STORAGE_LOCAL_DIR=../uploads
# S3_BUCKET=ebookhub-media
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=your_access_key
# S3_SECRET_ACCESS_KEY=your_secret_key

# Payment Gateway (RAZORPAY or DEMO)
PAYMENT_PROVIDER=DEMO
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_whsec_placeholder

# Commission & Payouts
PLATFORM_COMMISSION_PERCENT=15
MINIMUM_PAYOUT_AMOUNT=1000
